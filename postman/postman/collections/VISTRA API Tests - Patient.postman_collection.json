{
  "info": {
    "name": "VISTRA API Tests - Patient",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{api_version}}/health",
              "host": ["{{base_url}}", "{{api_version}}", "health"],
              "path": ["health"]
            },
            "description": "Health check endpoint"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health check returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has success field\", function () {",
                  "    pm.expect(json).to.have.property(\"success\");",
                  "    pm.expect(json.success).to.eql(true);",
                  "});"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"{{user_id}}\",\n    \"password\": \"{{patient_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/auth/login/",
              "host": ["{{base_url}}", "{{api_version}}", "auth", "login", ""],
              "path": ["auth", "login", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Patient login returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains access token\", function () {",
                  "    pm.expect(json).to.have.property(\"access_token\");",
                  "    pm.expect(json.access_token).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.environment.set(\"access_token\", json.access_token);",
                  "pm.environment.set(\"refresh_token\", json.refresh_token);"
                ]
              }
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/auth/refresh/",
              "host": ["{{base_url}}", "{{api_version}}", "auth", "refresh", ""],
              "path": ["auth", "refresh", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refresh returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"New access token is returned\", function () {",
                  "    pm.expect(json).to.have.property(\"access_token\");",
                  "    pm.environment.set(\"access_token\", json.access_token);",
                  "});"
                ]
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_version}}/auth/logout/",
              "host": ["{{base_url}}", "{{api_version}}", "auth", "logout", ""],
              "path": ["auth", "logout", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Patient logout returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.environment.unset(\"access_token\");",
                  "pm.environment.unset(\"refresh_token\");"
                ]
              }
            }
          }
        }
      ]
    },
